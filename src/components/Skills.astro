---
// src/components/Skills.astro

import { skillGroups, softSkills } from '../data/skills.js';
---

<section class="section section--alt" id="habilidades" aria-labelledby="skills-title">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title" id="skills-title">Habilidades</h2>
    </div>

    <div class="skills__grid">

      <!-- Hard skills -->
      <div class="skills__col">
        <h3 class="skills__col-title">Habilidades técnicas</h3>
        {skillGroups.map(({ title, variant, items }, i) => (
          <div class="skill-group">
            <h4 class="skill-group__title" id={`skill-group-${i}`}>{title}</h4>
            <ul class="skill-group__list" role="list" aria-labelledby={`skill-group-${i}`}>
              {items.map((item) => (
                <li><span class={`tag${variant ? ` tag--${variant}` : ''}`}>{item}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Soft skills -->
      <div class="skills__col">
        <h3 class="skills__col-title" id="hability-b">Habilidades blandas</h3>
        <ul class="soft-skills__list" role="list" aria-labelledby="hability-b">
          {softSkills.map(({ icon, name, description }) => (
            <li class="soft-skill">
              <span class="soft-skill__icon" aria-hidden="true">{icon}</span>
              <div class="soft-skill__content">
                <p class="soft-skill__name">{name}</p>
                <p class="soft-skill__desc">{description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  /* =============================================
     BLOCK: skills
  ============================================= */
  .skills__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  /* ELEMENT: skills__col-title */
  .skills__col-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 2px solid var(--color-accent);
    display: inline-block;
  }

  /* =============================================
     BLOCK: skill-group
  ============================================= */
  .skill-group { margin-bottom: var(--space-md); }

  /* ELEMENT: skill-group__title */
  .skill-group__title {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  /* ELEMENT: skill-group__list */
  .skill-group__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* =============================================
     BLOCK: soft-skill
  ============================================= */
  .soft-skills__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .soft-skill {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: 0.75rem var(--space-sm);
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  /* ELEMENT: soft-skill__icon */
  .soft-skill__icon {
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* ELEMENT: soft-skill__name */
  .soft-skill__name {
    font-weight: 600;
    margin-bottom: 0.15rem;
    color: var(--color-text);
  }

  /* ELEMENT: soft-skill__desc */
  .soft-skill__desc {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .skills__grid { grid-template-columns: 1fr; }
  }
</style>
