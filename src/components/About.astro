---
// src/components/About.astro
import saraCert from '../assets/certificates/sara_souiedan.pdf';
import weaaareAuditorias from '../assets/certificates/Certificado - Auditorías de Accesibilidad Digital - weAAAre.pdf';
import weaaareMovil from '../assets/certificates/Certificado - Introducción a la accesibilidad móvil - weAAAre.pdf';
import weaaareNvda from '../assets/certificates/Certificado - Pruebas de accesibilidad con lector de pantalla NVDA - weAAAre.pdf';

// En dev, Astro sirve los assets importados de src/assets sin el prefijo `base`
// configurado en astro.config.mjs, pero su middleware de dev exige ese prefijo
// para navegaciones directas (Accept: text/html), como al abrir un enlace en
// pestaña nueva. En build, la URL del import ya incluye el `base`, así que aquí
// solo se antepone en dev.
const withBase = (url: string) =>
  import.meta.env.DEV ? `${import.meta.env.BASE_URL}${url.replace(/^\//, '')}` : url;

const formacion = [
  {
    title: 'Accesibility — Sara Souiedan (2026)',
    href: 'https://practical-accessibility.today/',
    cert: withBase(saraCert),
  },
  {
    title: 'Auditorías de Accesibilidad Digital — WEAAAre (2026)',
    href: 'https://www.weaaare.com/app',
    cert: withBase(weaaareAuditorias),
  },
  {
    title: 'Introducción a la accesibilidad móvil — WEAAAre (2026)',
    href: 'https://www.weaaare.com/app',
    cert: withBase(weaaareMovil),
  },
  {
    title: 'Pruebas de accesibilidad con lector de pantalla NVDA — WEAAAre (2026)',
    href: 'https://www.weaaare.com/app',
    cert: withBase(weaaareNvda),
  },
];

const tools = [
  { label: 'HTML5' },
  { label: 'CSS3' },
  { label: 'SASS/SCSS' },
  { label: 'JavaScript ES6+' },
  { label: 'BEM' },
  { label: 'Astro',         variant: 'brown' },
  { label: 'Git & GitHub',  variant: 'green' },
  { label: 'NVDA',         variant: 'orange' },
  { label: 'TallBack',         variant: 'orange' },
  { label: 'Siteimprove',     variant: 'gray' },
  { label: 'WAVE',     variant: 'gray' },
  { label: 'Lighthouse',    variant: 'gray' },
  { label: 'axe DevTools',  variant: 'gray' },
];
---

<section class="section section--alt" id="sobre-mi" aria-labelledby="about-title">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title" id="about-title">Sobre mí</h2>
    </div>

    <div class="about__grid">

      <div class="about__text">
        <h3 class="about__subtitle">Mi enfoque de trabajo</h3>
        <p class="about__paragraph">
          Soy un maquetador web con más de 5 años transformando diseños en interfaces que no solo
          se ven bien, sino que también funcionan excepcionalmente en cualquier dispositivo y son
          accesibles para todas las personas.
        </p>
        <p class="about__paragraph">
          Mi metodología parte del <strong>HTML semántico</strong> como base sólida, construyo la
          arquitectura de estilos con <strong>SASS</strong> siguiendo la metodología <strong>BEM</strong>
          para garantizar componentes reutilizables y mantenibles, e integro todo en
          <strong>Astro</strong> para conseguir sitios ultra-rápidos con cero JavaScript innecesario.
        </p>
        <p class="about__paragraph">
          Me apasiona la accesibilidad: aplico las <strong>WCAG 2.2 nivel AA</strong> no como un
          requisito, sino como parte natural de mi proceso. Creo firmemente que una web bien
          construida debe ser para todo el mundo.
        </p>

        <h3 class="about__subtitle">Herramientas que domino</h3>
        <ul class="about__tools" role="list" aria-label="Tecnologías y herramientas">
          {tools.map(({ label, variant }) => (
            <li>
              <span class={`tag${variant ? ` tag--${variant}` : ''}`}>{label}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <div class="about__card">
          <h3 class="about__card-title">Experiencia</h3>
          <ul class="about__list" role="list">
            <li class="about__list-item">Altran / Capgemini - Maquetador Web (2018–2026)</li>
          </ul>
        </div>
        <div class="about__card about__card--mt">
          <h3 class="about__card-title">Formación</h3>
          <ul class="about__list" role="list">
            {formacion.map(({ title, href, cert }) => (
              <li class="about__list-item">
                <div class="about__list-content">
                  <a href={href} class="about__list-link">{title}</a>
                  <a
                    href={cert}
                    class="about__cert-link"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Ver certificado en PDF — ${title} (se abre en una pestaña nueva)`}
                  >
                    Certificado
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round"
                      aria-hidden="true" focusable="false">
                      <path d="M7 17 17 7" />
                      <path d="M8 7h9v9" />
                    </svg>
                  </a>
                </div>
              </li>
            ))}
            <li class="about__list-item">Full Stack web development - Skylabcoders (2017)</li>
            <li class="about__list-item">C.F.G.S Administración de sistemas informáticos - IE Esteve Terrades (2011)</li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* =============================================
     BLOCK: about
  ============================================= */
  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  /* ELEMENT: about__subtitle */
  .about__subtitle {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
    color: var(--color-text);
  }

  /* ELEMENT: about__paragraph */
  .about__paragraph {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: var(--space-md);
    line-height: 1.75;
  }

  /* ELEMENT: about__tools */
  .about__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-sm);
  }

  /* BLOCK: about__card */
  .about__card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  /* MODIFIER: about__card--mt */
  .about__card--mt { margin-top: var(--space-sm); }

  /* ELEMENT: about__card-title */
  .about__card-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  /* ELEMENT: about__list-item */
  .about__list-item {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .about__list-item:last-child { border-bottom: none; }
  .about__list-item::before {
    content: '';
    width: 6px;
    height: 6px;
    margin-top: 0.5em;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  /* ELEMENT: about__list-content */
  .about__list-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  /* ELEMENT: about__list-link */
  .about__list-link {
    display: block;
  }

  /* ELEMENT: about__cert-link */
  .about__cert-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid black;
    border-radius: var(--radius-sm, 4px);
    font-size: 0.8rem;
    white-space: nowrap;
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin: 0.2rem 0;
  }
  .about__cert-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .about__cert-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; }
  }
</style>
