---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import foto from '../assets/foto.jpg';
import cv from '../assets/curriculum_sergi.pdf';
import { profile, yearsExperience } from '../data/profile.js';
---

<section class="hero section" id="inicio" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero__inner">

      <div class="hero__content">
        <p class="hero__badge">
          <span class="hero__badge-dot" aria-hidden="true"></span>
          {profile.availability}
          {profile.location && <span class="hero__badge-location">· {profile.location}</span>}
        </p>

        <h1 class="hero__title" id="hero-title">
          {profile.name}
          <em class="hero__title-em">{profile.role} {profile.specialty}</em>
        </h1>

        <p class="hero__desc">
          Llevo {yearsExperience} años convirtiendo diseños en interfaces con
          <strong>HTML semántico</strong>, <strong>CSS/SASS</strong> y
          <strong>JavaScript</strong>, y compruebo que funcionan para todas las personas
          (<strong>WCAG 2.2 AA</strong>) con lectores de pantalla como NVDA y TalkBack.
        </p>

        <div class="hero__actions">
          <a href={cv} class="btn btn--primary" download>
            Descargar CV<span class="visually-hidden"> de {profile.name} (se descarga un archivo PDF)</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true" focusable="false">
              <path d="M12 3v12" />
              <path d="m7 10 5 5 5-5" />
              <path d="M5 21h14" />
            </svg>
          </a>
          <a href="#proyectos" class="btn btn--outline">
            <span class="visually-hidden">Ir a la sección</span>
            Ver proyectos
          </a>
        </div>

        <div class="hero__proof">
          <div class="hero__stats" role="list" aria-label="Datos profesionales">
            <div class="hero__stat" role="listitem">
              <span class="hero__stat-value">{yearsExperience}+</span>
              <span class="hero__stat-label">Años de experiencia</span>
            </div>
            <div class="hero__stat" role="listitem">
              <span class="hero__stat-value">AA</span>
              <span class="hero__stat-label">Conformidad WCAG 2.2</span>
            </div>
          </div>
          <p class="hero__clients">
            Proyectos para <strong>Generalitat de Catalunya</strong> y <strong>Telefónica</strong>
          </p>
        </div>
      </div>

      <div class="hero__avatar">
        <Image src={foto} alt={`Foto de ${profile.name}`} />
      </div>

    </div>
  </div>
</section>

<style>
  /* =============================================
     BLOCK: hero
  ============================================= */
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-xl);
    align-items: center;
  }

  /* ELEMENT: hero__badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35em 0.9em;
    border-radius: var(--radius-pill);
    background: var(--color-tag-green-bg);
    color: var(--color-tag-green-text);
    margin-bottom: var(--space-md);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  /* ELEMENT: hero__title */
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 3.8rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-md);
  }

  /* ELEMENT: hero__title-em */
  .hero__title-em {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.45em;
    font-style: normal;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-accent);
  }

  /* ELEMENT: hero__desc */
  .hero__desc {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 520px;
    margin-bottom: var(--space-lg);
    line-height: 1.7;
  }

  /* ELEMENT: hero__actions */
  .hero__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* ELEMENT: hero__proof */
  .hero__proof {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  /* ELEMENT: hero__clients */
  .hero__clients {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .hero__clients strong { color: var(--color-text); font-weight: 600; }

  /* ELEMENT: hero__stats */
  .hero__stats {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  /* ELEMENT: hero__stat */
  .hero__stat { display: flex; flex-direction: column; }

  /* ELEMENT: hero__stat-value */
  .hero__stat-value {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1;
  }

  /* ELEMENT: hero__stat-label */
  .hero__stat-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  /* ELEMENT: hero__avatar */
  .hero__avatar {
    width: 200px;
    height: 200px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    flex-shrink: 0;
    border: 3px solid var(--color-border);
  }

  .hero__avatar img {
    height: auto;
  }

  /* ELEMENT: hero__avatar-placeholder */
  .hero__avatar-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #ddd8cf 0%, #c8c3bb 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__avatar { margin: 0 auto; }
  }

  @media (max-width: 900px) {
    .hero__title-em { font-size: 0.6em; }
  }
</style>
